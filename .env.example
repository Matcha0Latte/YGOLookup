# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Where the canonical SQLite database lives.
YGO_DB_PATH=data/processed/ygolookup.db

# Directory used to keep immutable raw source payloads (cdb files, API dumps).
YGO_RAW_DIR=data/raw

# Optional: base URL used by the YGOProDeck JSON ingest adapter.
YGO_YGOPRODECK_API=https://db.ygoprodeck.com/api/v7/cardinfo.php

# Semantic retrieval is optional. Leave empty to use the deterministic fallback
# backend. Example: sentence-transformers/all-MiniLM-L6-v2
YGO_EMBEDDING_MODEL=

# Only used by future LLM query-planner / effect-extraction adapters.
# YGO_LLM_BASE_URL=
# YGO_LLM_API_KEY=
